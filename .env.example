# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Supabase project URL (Dashboard -> Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key ("sb_publishable_..." or the legacy anon key).
# NEVER put a service-role / secret key here.
SUPABASE_KEY=

# Google OAuth web client ID (same one configured in Supabase -> Authentication -> Providers -> Google)
GOOGLE_CLIENT_ID=
